# Copy to .env for local development. .env and .env.production are gitignored —
# Vite inlines these values into the built bundle, so never commit a real one.

# Relative = same-origin; the Vite dev proxy (vite.config.js) forwards /api to
# the backend on :7007, keeping the auth refresh cookie first-party (no
# cross-origin logouts). Set an absolute URL only to point at a remote API.
#
# Unlike the hms app, this URL DOES include the /api/v1 suffix (axios strips it
# only to hit /auth/refresh-token on the same origin). In production:
#   VITE_API_URL=https://api.example.com/api/v1
VITE_API_URL=/api/v1

# Where the tenant/staff app (hms) is served. The "Login as Hospital" button
# opens <VITE_HMS_URL>/impersonate?token=… in a new tab. Must point at the hms
# app (port 7006 in dev), NOT this operator console — otherwise impersonation
# lands back here and bounces to login. Set this in .env.production too, or
# prod impersonation falls back to http://localhost:7006.
VITE_HMS_URL=http://localhost:7006
