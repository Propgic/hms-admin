# Backend API base URL — INCLUDES /api/v1 (admin axios baseURL matches it as-is).
VITE_API_URL=http://localhost:5001/api/v1

# Network timeout + retry knobs. Defaults shown — only set to override.
# Request timeout in ms before axios aborts a hanging call.
# VITE_API_TIMEOUT_MS=30000
# Number of automatic retries on transient errors. 0 disables retries.
# VITE_API_RETRIES=2
